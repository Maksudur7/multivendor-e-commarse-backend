# ══════════════════════════════════════════════════════════════
# Enterprise E-Commerce Backend — Environment Configuration
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# ── SERVER ──────────────────────────────────────────────────
APP_ENV=development
APP_NAME=ecom-backend
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

# ── DATABASE (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://ecom_user:ecom_secret_password@localhost:5432/ecom_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300s

# ── REDIS ────────────────────────────────────────────────────
REDIS_URL=redis://:ecom_redis_password@localhost:6379/0
REDIS_MAX_RETRIES=3

# ── JWT SECRETS (use 256-bit random strings in production) ──
JWT_ACCESS_SECRET=dev_access_secret_change_in_production_256bit
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_256bit
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# ── MEILISEARCH ──────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=ecom_meili_master_key_dev
MEILI_PRODUCT_INDEX=products

# ── CLOUDFLARE R2 (S3-compatible) ───────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=ecom-public
R2_PRIVATE_BUCKET=ecom-private
R2_PUBLIC_CDN_URL=https://cdn.yoursite.com

# ── PAYMENT GATEWAYS ─────────────────────────────────────────
# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=https://yoursite.com/payment/sslcommerz/success
SSLCOMMERZ_FAIL_URL=https://yoursite.com/payment/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=https://yoursite.com/payment/sslcommerz/cancel

# bKash
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=true
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_IS_SANDBOX=true
NAGAD_CALLBACK_URL=https://yoursite.com/webhooks/nagad

# ── COURIER APIs ─────────────────────────────────────────────
# Steadfast
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# Pathao
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_BASE_URL=https://api-hermes.pathao.com/aladdin/api/v1

# RedX
REDX_API_KEY=
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta

# ── SMS GATEWAY ──────────────────────────────────────────────
SMS_PROVIDER=greenweb
GREENWEB_API_TOKEN=
GREENWEB_SENDER_ID=YourBrand
REVE_API_KEY=
REVE_SENDER_ID=YourBrand

# ── WHATSAPP (Meta Cloud API) ────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0

# ── EMAIL ────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=YourPlatform
EMAIL_FROM_ADDRESS=noreply@yoursite.com

# ── FIREBASE (Push Notifications) ───────────────────────────
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ── GOOGLE OAUTH ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://yoursite.com/auth/google/callback

# ── PLATFORM DEFAULTS ────────────────────────────────────────
DEFAULT_COMMISSION_RATE=10.0
DEFAULT_COD_LIMIT=15000
NEW_USER_COD_LIMIT=5000
RETURN_WINDOW_DAYS=7
ESCROW_RELEASE_DAYS=7
MIN_SELLER_PAYOUT=500
MIN_RESELLER_PAYOUT=200
MIN_AFFILIATE_PAYOUT=500

# ── FRAUD THRESHOLDS ─────────────────────────────────────────
FRAUD_BLOCK_SCORE=81
FRAUD_REVIEW_SCORE=61
MAX_ACCOUNTS_PER_IP=3
OTP_RATE_LIMIT_PER_HOUR=5
CHECKOUT_RATE_LIMIT_PER_HOUR=10
